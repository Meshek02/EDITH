# Loaded and validated by Pydantic Settings at startup; .env is optional.
# Phase 1 rejects enabled AI/control/remote flags and hosts other than 127.0.0.1.
# Provider/database settings are reserved: no clients or database are created.
EDITH_NAME=EDITH
EDITH_ENV=development
EDITH_HOST=127.0.0.1
EDITH_PORT=8000
EDITH_LOG_LEVEL=INFO

EDITH_AI_ENABLED=false
EDITH_WINDOWS_CONTROL_ENABLED=false
EDITH_REMOTE_ACCESS_ENABLED=false

EDITH_LOCAL_AI_PROVIDER=ollama
EDITH_CLOUD_AI_PROVIDER=openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=

# Proposed future path, relative to the documented runtime working directory.
# No data directory or database is created by this template.
EDITH_DATABASE_URL=sqlite:///./data/edith.db
